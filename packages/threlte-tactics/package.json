{
	"name": "threlte-tactics",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --cache --cache-strategy content --check . && eslint --cache --cache-location node_modules/.cache/eslint .",
		"format": "prettier --cache --cache-strategy content --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:install-browsers": "playwright install chromium",
		"convert": "node scripts/convert-unity.ts"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@threlte/core": "catalog:",
		"@threlte/extras": "catalog:",
		"@threlte/test": "catalog:",
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"playwright": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"runic-svelte-fsm": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"three": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:",
		"yaml": "catalog:"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
